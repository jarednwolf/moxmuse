{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "jsx": "preserve",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vitest/globals", "node"]
  },
  "include": [
    "next-env.d.ts",
    "lib/trpc/**/*.ts",
    "lib/trpc/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "e2e/**",
    "**/__tests__/**",
    "app/**",
    "components/**",
    "src/**"
  ]
} 