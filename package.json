{
  "name": "moxmuse",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@8.14.0",
  "scripts": {
    "test:run": "pnpm test:unit",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:e2e": "turbo run test:e2e",
    "test:smoke": "playwright test apps/web/e2e/smoke-tests.spec.ts",
    "test:comprehensive": "vitest run --config vitest.config.comprehensive.ts",
    "test:comprehensive:watch": "vitest --config vitest.config.comprehensive.ts",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:performance": "turbo run test:performance",
    "test:accessibility": "turbo run test:accessibility",
    "test:all": "pnpm test:comprehensive && pnpm test:e2e",
    "test:ci": "pnpm test:comprehensive --reporter=junit --reporter=json && pnpm test:e2e --reporter=junit",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:migrate": "turbo run db:migrate",
    "db:migrate:deploy": "turbo run db:migrate:deploy",
    "db:migrate:status": "turbo run db:migrate:status",
    "db:seed:test": "turbo run db:seed:test",
    "db:studio": "turbo run db:studio",
    "db:reset": "turbo run db:reset",
    "clean": "turbo run clean",
    "analyze": "turbo run analyze",
    "audit": "pnpm audit --audit-level moderate",
    "deployment:health-check": "node scripts/deployment/health-check.js",
    "deployment:verify": "node scripts/deployment/verify.js",
    "deployment:monitor": "node scripts/deployment/monitor.js",
    "deployment:rollback": "node scripts/deployment/rollback.js",
    "postinstall": "node scripts/safe-db-generate.js"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "3.2.4",
    "axios": "^1.6.5",
    "dotenv": "^17.2.0",
    "puppeteer": "^24.15.0",
    "tsx": "^4.20.3",
    "turbo": "^1.11.3",
    "typescript": "^5.3.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "dependencies": {
    "@sentry/node": "^7.99.0",
    "@sentry/profiling-node": "^1.3.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/uuid": "^9.0.8",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.1.5",
    "uuid": "^9.0.1"
  }
}
