{
  "name": "@moxmuse/db",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "db:generate": "prisma generate",
    "db:push": "prisma db push --skip-generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed:test": "echo 'No seed script'",
    "db:import-scryfall": "tsx scripts/import-scryfall-bulk.ts",
    "db:manage": "tsx scripts/manage-card-database.ts",
    "lint": "eslint --ext .ts,.tsx src scripts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:integration": "echo 'No integration tests'",
    "test:performance": "echo 'No performance tests'",
    "analyze": "echo 'No analyze script'"
  },
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "@types/bcryptjs": "^3.0.0",
    "axios": "^1.12.0",
    "bcryptjs": "^3.0.2"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.6.1",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@types/node": "^20.10.5",
    "commander": "^11.1.0",
    "cron": "^3.1.6",
    "dotenv": "^17.2.0",
    "eslint": "^8.56.0",
    "eslint-config-next": "14.0.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "prisma": "^5.7.1",
    "tsx": "^4.20.3",
    "typescript": "^5.3.3",
    "vitest": "^1.0.0"
  }
}
