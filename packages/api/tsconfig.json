{
  "compilerOptions": {
    "target": "es2019",
    "lib": ["ES2021", "DOM"],
    "module": "commonjs",
    "rootDir": "./src",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "allowJs": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "types": ["vitest/globals", "node"],
    "downlevelIteration": true
  },
  "include": [
    "src/index.ts",
    "src/trpc.ts",
    "src/auth.ts",
    "src/types/**/*.d.ts",
    "src/middleware/error-handler.ts",
    "src/middleware/monitoring.ts",
    "src/middleware/rate-limiter.ts",
    "src/services/monitoring/**/*.ts",
    "src/routers/health.ts",
    "src/routers/monitoring.ts",
    "src/routers/security.ts",
    "src/routers/collection.ts",
    "src/routers/deck.ts",
    "src/routers/deck-template.ts",
    "src/routers/card-database.ts",
    "src/routers/card-search.ts",
    "src/routers/card-synergy.ts",
    "src/routers/folder-management.ts",
    "src/routers/format-legality.ts",
    "src/routers/tutor.ts",
    "src/routers/integration.ts",
    "src/routers/ai-health.ts",
    "src/routers/performance.ts"
  ],
  "exclude": [
    "node_modules",
    "src/**/__tests__/**",
    "src/routers/**",
    "src/scripts/**",
    "src/config/scalability.ts",
    "src/middleware/scalability.ts",
    "src/services/scaling/**",
    "src/services/learning/**",
    "src/services/platform-adapters/**",
    "src/services/deck-maintenance/**",
    "src/services/performance/**",
    "src/services/integration/**",
    "src/services/core/**",
    "src/services/enhanced-card-data.ts",
    "src/services/enhanced-card-search.ts",
    "src/services/card-data-sync.ts",
    "src/services/advanced-deck-search.ts",
    "src/services/card-database-management.ts",
    "src/services/persistence/**",
    "src/services/ai/**",
    "src/services/sync-job-scheduler.ts",
    "src/services/core/index.ts",
    "src/services/platform-adapters/adapter-registry.ts",
    "src/services/database/QueryOptimizer.ts"
  ]
} 